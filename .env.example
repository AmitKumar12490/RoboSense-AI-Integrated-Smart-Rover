# RoboSense AI Integration Environment Configuration
# Copy this file to .env and configure your credentials.
# NEVER commit your actual .env file or API keys to version control.

# OpenAI API Key for high-level command parsing and telemetry diagnostics
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration
OPENAI_MODEL=gpt-4o-mini

# ESP32 Serial Bridge Configuration
ESP32_SERIAL_PORT=COM3
ESP32_BAUD_RATE=115200

# Telemetry streaming port (for optional web dashboard / WebSocket)
TELEMETRY_PORT=8080
